# ==================== SUPABASE ====================
# Obtenha essas credenciais em https://supabase.com
REACT_APP_SUPABASE_URL=https://seu-projeto.supabase.co
REACT_APP_SUPABASE_ANON_KEY=sua-chave-publica-aqui

# ==================== APP ====================
REACT_APP_NAME=Gestão Incubadora
REACT_APP_VERSION=1.0.0
REACT_APP_ENVIRONMENT=production

# ==================== API ====================
REACT_APP_API_TIMEOUT=30000
REACT_APP_MAX_UPLOAD_SIZE=52428800  # 50MB em bytes

# ==================== AUTENTICAÇÃO ====================
# Token JWT válido por (horas)
REACT_APP_TOKEN_EXPIRY=24

# ==================== STORAGE ====================
# Bucket do Supabase para documentos
REACT_APP_STORAGE_BUCKET=documentos-incubadora
REACT_APP_STORAGE_REGION=us-east-1
